{
  "name": "rcwriter",
  "productName": "RCWriter",
  "version": "1.6.0",
  "description": "Desktop app that writes articles on a schedule using Claude, ChatGPT, Gemini or any OpenAI-compatible model.",
  "main": "src/main.js",
  "author": "You",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win --x64",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "resedit": "^1.7.2"
  },
  "build": {
    "appId": "com.rcwriter.app",
    "productName": "RCWriter",
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json",
      "node_modules/**/*"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "RCWriter",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "include": "build/installer.nsh",
      "artifactName": "RCWriter-Setup-${version}.exe",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true,
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/uninstallerSidebar.bmp"
    },
    "mac": {
      "target": "dmg",
      "icon": "assets/icon.png",
      "category": "public.app-category.productivity"
    },
    "linux": {
      "target": "AppImage",
      "icon": "assets/icon.png",
      "category": "Office",
      "mimeTypes": [
        "x-scheme-handler/rcwriter"
      ]
    },
    "protocols": [
      {
        "name": "RCWriter",
        "schemes": [
          "rcwriter"
        ]
      }
    ],
    "afterPack": "build/after-pack.js",
    "publish": null,
    "asarUnpack": [
      "src/gateway.js"
    ]
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1"
  }
}